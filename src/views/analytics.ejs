<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/admin.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<body>
  <canvas class="liquid-canvas"></canvas>

  <div class="admin-container">
    <%- include('includes/nav', { active: 'analytics' }) %>

    <div class="admin-board">
      <div class="board-head">
        <div>
          <h1 class="board-title">Analytics</h1>
          <div class="board-sub">Last <%= dashboard.days %> days · paid orders only · KST</div>
        </div>
        <div class="range-tabs">
          <% ranges.forEach(function(d) { %>
            <a class="range-tab <%= d === dashboard.days ? 'active' : '' %>" href="/admin/analytics?days=<%= d %>"><%= d %> days</a>
          <% }) %>
        </div>
      </div>

      <div class="kpi-grid">
        <div class="glass-card kpi"><span>Revenue</span><b>₩<%= dashboard.summary.revenue.toLocaleString('ko-KR') %></b></div>
        <div class="glass-card kpi"><span>Orders</span><b><%= dashboard.summary.orderCount %></b></div>
        <div class="glass-card kpi"><span>Avg. order</span><b>₩<%= dashboard.summary.avgOrderValue.toLocaleString('ko-KR') %></b></div>
        <div class="glass-card kpi"><span>New members</span><b><%= dashboard.summary.newMembers %></b></div>
        <div class="glass-card kpi"><span>Reservations</span><b><%= dashboard.summary.reservationCount %></b></div>
      </div>

      <div class="chart-grid">
        <div class="glass-card chart-card wide">
          <h3>Daily revenue</h3>
          <canvas id="dailyChart"></canvas>
        </div>
        <div class="glass-card chart-card">
          <h3>Top 5 dishes</h3>
          <% if (!dashboard.topProducts.length) { %>
            <div class="empty-state">No data</div>
          <% } else { %>
          <ol class="top-list">
            <% dashboard.topProducts.forEach(function(p) { %>
              <li><span><%= p.productName %></span><b><%= p.quantity %> sold</b><em>₩<%= p.revenue.toLocaleString('ko-KR') %></em></li>
            <% }) %>
          </ol>
          <% } %>
        </div>
        <div class="glass-card chart-card">
          <h3>Orders by hour</h3>
          <canvas id="hourlyChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script>
    window.__DASHBOARD__ = <%- JSON.stringify(dashboard).replace(/</g, "\\u003c") %>;
  </script>
  <script src="/js/analytics.js"></script>
  <script src="/js/background.js"></script>
</body>

<%- include('includes/footer') %>
</html>
