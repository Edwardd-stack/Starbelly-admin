<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/admin.css" />

<body>
  <canvas class="liquid-canvas"></canvas>

  <div class="admin-container">
    <%- include('includes/nav', { active: 'reservations' }) %>

    <div class="admin-board">
      <div class="board-head">
        <div>
          <h1 class="board-title">Reservations</h1>
          <div class="board-sub"><%= reservations.length %> ta bron</div>
        </div>
        <form class="date-form" method="get" action="/admin/reservation/all">
          <input type="date" name="date" value="<%= date %>" onchange="this.form.submit()" />
          <span class="live-dot" id="live-status">Offline</span>
        </form>
      </div>

      <% if (!reservations.length) { %>
        <div class="empty-state">Bu kunga bron yo'q</div>
      <% } else { %>
      <table class="admin-table">
        <thead>
          <tr><th>Vaqt</th><th>Stol</th><th>Mehmon</th><th>Mijoz</th><th>Izoh</th><th>Holat</th><th></th></tr>
        </thead>
        <tbody>
          <% reservations.forEach(function(r) { %>
          <tr data-id="<%= r._id %>">
            <td><b><%= r.timeSlot %></b></td>
            <td>№<%= r.tableData.tableNumber %> <span class="board-sub">(<%= r.tableData.tableSeats %> o'rin)</span></td>
            <td><%= r.guestCount %> kishi</td>
            <td><%= r.memberData.memberNick %><br /><span class="board-sub"><%= r.memberData.memberPhone %></span></td>
            <td class="board-sub"><%= r.reservationMemo || '—' %></td>
            <td><span class="status-badge status-<%= r.reservationStatus %>"><%= r.reservationStatus %></span></td>
            <td style="white-space: nowrap">
              <% if (r.reservationStatus === 'PAUSE') { %>
                <button class="btn-pill btn-ok status-btn" data-status="CONFIRM">Tasdiqlash</button>
                <button class="btn-pill btn-danger status-btn" data-status="CANCEL">Bekor</button>
              <% } else if (r.reservationStatus === 'CONFIRM') { %>
                <button class="btn-pill btn-warn status-btn" data-status="FINISH">Keldi</button>
                <button class="btn-pill btn-danger status-btn" data-status="CANCEL">Bekor</button>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/reservations.js"></script>
  <script src="/js/background.js"></script>
</body>

<%- include('includes/footer') %>
</html>
